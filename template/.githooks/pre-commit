#!/usr/bin/env bash
# LLM Wiki Workspace: front matter check.
#
# Rejects a commit when a staged markdown file lacks any of the four required fields.
# Warns, without rejecting, when a file's review_by date has passed. It checks the
# staged version of each file, which is what the commit will contain.
#
# Enable with:  git config core.hooksPath .githooks

set -uo pipefail

REQUIRED="status updated owner classification"
today=$(date +%F)
fail=0

# Front matter of the staged version: the lines between the opening '---' and the next.
staged_frontmatter() {
  git show ":$1" 2>/dev/null | awk 'NR==1 && $0 != "---" { exit }
                                    NR==1 { next }
                                    $0 == "---" { exit }
                                    { print }'
}

while IFS= read -r f; do
  [ -n "$f" ] || continue
  fm=$(staged_frontmatter "$f")

  if [ -z "$fm" ]; then
    echo "front matter missing entirely: $f"
    fail=1
    continue
  fi

  for k in $REQUIRED; do
    if ! printf '%s\n' "$fm" | grep -q "^$k:[[:space:]]*[^[:space:]]"; then
      echo "front matter missing '$k': $f"
      fail=1
    fi
  done

  review=$(printf '%s\n' "$fm" | grep -m1 '^review_by:' | sed 's/^review_by:[[:space:]]*//; s/["'\'']//g')
  case "$review" in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9])
      if [ "$review" \< "$today" ]; then echo "warning: review_by $review has passed: $f"; fi ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACM \
         | grep '\.md$' \
         | grep -v '^work/temp/' \
         | grep -vE '(^|/)(README|AGENTS)\.md$')

exit $fail
